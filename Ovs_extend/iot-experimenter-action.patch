+        a->type = htons(IOT_OFPAT_EXPERIMENTER);
+        a->experimenter = htonl(IOT_EXPERIMENTER_ID);
+        ofpbuf_put(out, note->data + 4, note->length - 4);
+        pad_ofpat(out, start_ofs);
