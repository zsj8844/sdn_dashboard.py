+/* OpenFlow 1.3 experimenter action carrying IoT metadata.
+ *
+ * Vendor IOT_EXPERIMENTER_ID (0x12345678) is not one of the vendors that
+ * Open vSwitch natively knows, so without this it would be rejected with
+ * OFPBAC_BAD_VENDOR.  We accept it and preserve its payload as an
+ * OFPACT_NOTE, prefixed with the vendor ID.  The prefix lets format_NOTE()
+ * and encode_NOTE() reproduce the original experimenter action. */
+#define IOT_OFPAT_EXPERIMENTER 0xffff
+#define IOT_EXPERIMENTER_ID    0x12345678u
+
+struct ofp_action_experimenter_iot {
+    ovs_be16 type;                  /* IOT_OFPAT_EXPERIMENTER. */
+    ovs_be16 len;
+    ovs_be32 experimenter;          /* IOT_EXPERIMENTER_ID. */
+    uint8_t data[];
+};
+OFP_ASSERT(sizeof(struct ofp_action_experimenter_iot) == 8);
+
+static bool
+note_is_iot(const struct ofpact_note *note)
+{
+    static const uint8_t vendor[4] = { 0x12, 0x34, 0x56, 0x78 };
+
+    return note->length >= sizeof vendor
+           && !memcmp(note->data, vendor, sizeof vendor);
+}
+
 static enum ofperr
